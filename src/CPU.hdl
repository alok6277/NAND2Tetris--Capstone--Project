
CHIP CPU {
    IN inM[16],
       instruction[16],
       reset;

    OUT outM[16],
        writeM,
        addressM[15],
        pc[15];

    PARTS:

    // Instruction decoding

    Not(
        in=instruction[15],
        out=notC
    );

    And(
        a=instruction[15],
        b=instruction[5],
        out=destA
    );

    Or(
        a=notC,
        b=destA,
        out=loadA
    );

    And(
        a=instruction[15],
        b=instruction[4],
        out=loadD
    );

    And(
        a=instruction[15],
        b=instruction[3],
        out=writeM
    );

    // A Register input

    Mux16(
        a=instruction,
        b=outM,
        sel=instruction[15],
        out=aIn
    );

    ARegister(
        in=aIn,
        load=loadA,
        out=aReg,
        out[0..14]=addressM
    );

    // D Register

    DRegister(
        in=outM,
        load=loadD,
        out=dReg
    );

    // ALU input selection

    Mux16(
        a=aReg,
        b=inM,
        sel=instruction[12],
        out=y
    );

    // ALU

    ALU(
        x=dReg,
        y=y,
        zx=instruction[11],
        nx=instruction[10],
        zy=instruction[9],
        ny=instruction[8],
        f=instruction[7],
        no=instruction[6],
        out=outM,
        zr=zr,
        ng=ng
    );

    // Jump conditions

    And(
        a=ng,
        b=instruction[2],
        out=jlt
    );

    And(
        a=zr,
        b=instruction[1],
        out=jeq
    );

    Not(
        in=ng,
        out=notNg
    );

    Not(
        in=zr,
        out=notZr
    );

    And(
        a=notNg,
        b=notZr,
        out=positive
    );

    And(
        a=positive,
        b=instruction[0],
        out=jgt
    );

    Or(
        a=jlt,
        b=jeq,
        out=jump1
    );

    Or(
        a=jump1,
        b=jgt,
        out=jumpAny
    );

    And(
        a=instruction[15],
        b=jumpAny,
        out=pcLoad
    );

    // Program Counter

    PC(
        in=aReg,
        load=pcLoad,
        inc=true,
        reset=reset,
        out=pc
    );
}
